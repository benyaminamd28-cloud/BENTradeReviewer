<Application x:Class="BENTradeReviewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BENTradeReviewer.UI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/TerminalTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:IntToBoolConverter x:Key="IntToBoolConverter" />
            <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <conv:BoolToVisConverter x:Key="BoolToVisConverter" />
            <conv:IsNegativeConverter x:Key="IsNegativeConverter" />
            <conv:SecondsToTimeSpanConverter x:Key="SecondsToTimeSpanConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
