<Window x:Class="BENTradeReviewer.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEN TRADE REVIEWER"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundDark}">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,35">

            <TextBlock Text="BEN"
                       Foreground="{StaticResource BrushAccentBlue}"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="TRADE REVIEWER"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="SELECT YOUR TRADING PLATFORM"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <!-- MODES -->

        <Grid Grid.Row="1"
              HorizontalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- NINJATRADER -->

            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurfaceDark}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="NINJATRADER"
                               Foreground="{StaticResource BrushAccentBlue}"
                               FontSize="21"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="FULL TRADE JOURNAL"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="Recorder • Video • Replay"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Risk / Reward • MAE / MFE"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,25"/>

                    <Button Content="OPEN NINJATRADER MODE"
                            Click="NinjaTrader_Click"
                            Style="{StaticResource TerminalButton}"
                            Height="42"/>

                </StackPanel>
            </Border>

            <!-- METATRADER -->

            <Border Grid.Column="2"
                    Background="{StaticResource BrushSurfaceDark}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="METATRADER"
                               Foreground="{StaticResource BrushAccentPurple}"
                               FontSize="21"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="LIGHTWEIGHT JOURNAL"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="EA • Entry / Exit • Partial Exit"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Stop Loss • P&amp;L • Win Rate"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,25"/>

                    <Button Content="OPEN METATRADER MODE"
                            Click="MetaTrader_Click"
                            Style="{StaticResource TerminalButton}"
                            Height="42"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- FOOTER -->

        <TextBlock Grid.Row="2"
                   Text="BEN Trade Reviewer"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Margin="0,25,0,0"/>

    </Grid>
</Window>
