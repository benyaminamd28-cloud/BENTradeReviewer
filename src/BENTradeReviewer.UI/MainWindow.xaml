                                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="TRADES" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/><TextBlock Text="{Binding Summary.TotalTrades}" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
