                                <Button Content="SAVE NOTES" Command="{Binding SaveNotesCommand}" Style="{StaticResource TerminalButton}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding NotesSaveStatus}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                <Separator Margin="0,10,0,8" Background="{StaticResource BrushBorder}"/>
                                <Border Style="{StaticResource CardPanel}" Padding="8" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="JOURNAL CHECKLIST" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding ChecklistSaveStatus}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,0,0,7" TextWrapping="Wrap"/>
                                        <StackPanel IsEnabled="{Binding IsJournalChecklistLoaded}">
                                            <TextBlock Text="SETUP" Foreground="{StaticResource BrushAccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,2,0,5"/>
                                            <UniformGrid Columns="2" Margin="0,0,0,7">
                                                <CheckBox Content="hunt-p3" IsChecked="{Binding HuntP3, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="hunt-p2" IsChecked="{Binding HuntP2, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="chop-p2" IsChecked="{Binding ChopP2, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="chop-p3" IsChecked="{Binding ChopP3, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="MAJOR SWING" IsChecked="{Binding MajorSwing, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="ORDER BLOCK" IsChecked="{Binding OrderBlock, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Running-HS" IsChecked="{Binding RunningHS, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Running-LS" IsChecked="{Binding RunningLS, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                            </UniformGrid>
                                            <Separator Margin="0,5,0,7" Background="{StaticResource BrushBorder}"/>
                                            <TextBlock Text="BOX CHART" Foreground="{StaticResource BrushAccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,2,0,5"/>
                                            <StackPanel Margin="0,0,0,7">
                                                <CheckBox Content="Bullish DOM pressure" IsChecked="{Binding BoxBullishDomPressure, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Bearish DOM pressure" IsChecked="{Binding BoxBearishDomPressure, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Large Volume By Bid" IsChecked="{Binding BoxLargeVolumeByBid, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Large Volume By Ask" IsChecked="{Binding BoxLargeVolumeByAsk, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Big Trade Sweep by Ag-Buyer" IsChecked="{Binding BoxBigTradeSweepAgBuyer, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Big Trade Sweep by Ag-Seller" IsChecked="{Binding BoxBigTradeSweepAgSeller, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Big Trade Absorption of Ag-Buyer" IsChecked="{Binding BoxBigTradeAbsorptionAgBuyer, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Big Trade Absorption of Ag-Seller" IsChecked="{Binding BoxBigTradeAbsorptionAgSeller, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="SELL TRADE SIZE CC BEARISH" IsChecked="{Binding BoxSellTradeSizeCCBearish, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="SELL TRADE SIZE CC BULLISH" IsChecked="{Binding BoxSellTradeSizeCCBullish, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="BOTH TRADE SIZE CC BULLISH" IsChecked="{Binding BoxBothTradeSizeCCBullish, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="BOTH TRADE SIZE CC BEARISH" IsChecked="{Binding BoxBothTradeSizeCCBearish, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="BUY TRADE SIZE CC BEARISH" IsChecked="{Binding BoxBuyTradeSizeCCBearish, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="BUY TRADE SIZE CC BULLISH" IsChecked="{Binding BoxBuyTradeSizeCCBullish, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                            </StackPanel>
                                            <Separator Margin="0,5,0,7" Background="{StaticResource BrushBorder}"/>                                            <TextBlock Text="FOOTPRINT" Foreground="{StaticResource BrushAccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,2,0,5"/>
                                            <UniformGrid Columns="2" Margin="0,0,0,7">
                                                <CheckBox Content="Cover candle" IsChecked="{Binding FootprintCoverCandle, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Ag-Buyer Absorption" IsChecked="{Binding FootprintAgBuyerAbsorption, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Delta Convergence ± 10" IsChecked="{Binding FootprintDeltaConvergence10, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Ag-Seller Absorption" IsChecked="{Binding FootprintAgSellerAbsorption, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Delta Divergence ± 8" IsChecked="{Binding FootprintDeltaDivergence8, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Ag-Buyer Exhaustion" IsChecked="{Binding FootprintAgBuyerExpulsion, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                            </UniformGrid>
                                            <TextBlock Text="Value in Bullish — Range Bar" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="2,2,2,3"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,5">
                                                <CheckBox Content="Low" IsChecked="{Binding FootprintBullishValueLow, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Mid" IsChecked="{Binding FootprintBullishValueMid, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Top" IsChecked="{Binding FootprintBullishValueTop, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                            </UniformGrid>
                                            <TextBlock Text="Value in Bearish — Range Bar" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="2,2,2,3"/>
                                            <UniformGrid Columns="3" Margin="0,0,0,7">
                                                <CheckBox Content="Low" IsChecked="{Binding FootprintBearishValueLow, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Mid" IsChecked="{Binding FootprintBearishValueMid, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                                <CheckBox Content="Top" IsChecked="{Binding FootprintBearishValueTop, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="2"/>
                                            </UniformGrid>
                                            <Separator Margin="0,5,0,7" Background="{StaticResource BrushBorder}"/>
                                            <TextBlock Text="ORDER BOOK" Foreground="{StaticResource BrushAccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,2,0,4"/>
                                            <TextBlock Text="Order Book checklist criteria to be configured." Foreground="{StaticResource BrushTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="2,0,2,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="TRADE MARKET CONTEXT" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                                <TextBlock Text="SESSION" Foreground="{StaticResource BrushAccentBlue}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.Session, Mode=TwoWay}" SelectedValuePath="Content" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="RTH"/>
                                    <ComboBoxItem Content="ETH"/>
                                    <ComboBoxItem Content="Unknown"/>
                                </ComboBox>

                                <TextBlock Text="EXECUTION QUALITY" Foreground="{StaticResource BrushAccentBlue}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.ExecutionQuality, Mode=TwoWay}" SelectedValuePath="Content" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Perfect"/>
                                    <ComboBoxItem Content="Acceptable"/>
                                    <ComboBoxItem Content="Early"/>
                                    <ComboBoxItem Content="Late"/>
                                    <ComboBoxItem Content="Chase"/>
                                    <ComboBoxItem Content="Hesitated"/>
                                </ComboBox>

                                <TextBlock Text="CONTEXT CONFIDENCE" Foreground="{StaticResource BrushAccentBlue}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.ContextConfidence, Mode=TwoWay}" SelectedValuePath="Tag" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8">
                                    <ComboBoxItem Tag="0" Content="Low"/>
                                    <ComboBoxItem Tag="1" Content="Medium"/>
                                    <ComboBoxItem Tag="2" Content="High"/>
                                </ComboBox>

                                <TextBlock Text="TRADE QUALITY" Foreground="{StaticResource BrushAccentBlue}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.TradeQuality, Mode=TwoWay}" SelectedValuePath="Tag" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10">
                                    <ComboBoxItem Tag="0" Content="Not Rated"/>
                                    <ComboBoxItem Tag="1" Content="★"/>
                                    <ComboBoxItem Tag="2" Content="★★"/>
                                    <ComboBoxItem Tag="3" Content="★★★"/>
                                    <ComboBoxItem Tag="4" Content="★★★★"/>
                                    <ComboBoxItem Tag="5" Content="★★★★★"/>
                                </ComboBox>

                                <Button Content="SAVE MARKET CONTEXT" Command="{Binding SaveMarketContextCommand}" Style="{StaticResource TerminalButton}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding DataContext.SelectedNavigationIndex,
                         RelativeSource={RelativeSource AncestorType=Window},
                         Converter={StaticResource IntToVisibilityConverter},
                         ConverterParameter=3}">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="350"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- SETTINGS PANEL -->
    <Border Grid.Column="0"
            Style="{StaticResource CardPanel}"
            MaxWidth="700"
            HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="SETTINGS &amp; RECORDER INTEGRATION"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="BEN Trade Recorder Source Path"
                       Foreground="{StaticResource BrushTextSecondary}"
                       Margin="0,0,0,4"/>

            <TextBox Text="{Binding SettingsVM.RecorderPath, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource BrushSurfaceLight}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}"
                     Padding="6"/>

            <CheckBox Content="Enable hardware-accelerated video playback"
                      IsChecked="{Binding SettingsVM.EnableHardwareAcceleration}"
                      Foreground="{StaticResource BrushTextPrimary}"
                      Margin="0,15,0,0"/>

            <CheckBox Content="Watch folder for automated real-time trade import"
                      IsChecked="{Binding SettingsVM.AutoWatchFolder}"
                      Foreground="{StaticResource BrushTextPrimary}"
                      Margin="0,10,0,0"/>

            <TextBlock Text="Supported video slots: Monitor 1–4. Missing files remain blank."
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="11"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Border>

    <!-- BEN LOGO AREA: SETTINGS ONLY -->
    <Grid Grid.Column="1"
          Background="Black"
          Margin="0">
        <Image Source="/BENTradeReviewer.UI;component/Assets/BENLogo.png"
               Opacity="0.70"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"/>
    </Grid>
</Grid>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BrushSurfaceDark}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="10,0"><DockPanel><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" FontSize="11"/><ProgressBar IsIndeterminate="True" Width="110" Height="10" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/></DockPanel></Border>
    </Grid>
</Window>
