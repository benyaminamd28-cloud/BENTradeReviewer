<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BEN Trade Reviewer — Ultra-Luxury Obsidian / Champagne Gold design system -->
    <Color x:Key="ColorBackgroundDark">#05080D</Color>
    <Color x:Key="ColorSurfaceDark">#09111A</Color>
    <Color x:Key="ColorSurfaceLight">#111B27</Color>
    <Color x:Key="ColorSurfaceRaised">#14212E</Color>
    <Color x:Key="ColorBorder">#263848</Color>
    <Color x:Key="ColorBorderBright">#3B596A</Color>
    <Color x:Key="ColorGold">#D4AF37</Color>
    <Color x:Key="ColorGoldBright">#FFDF73</Color>
    <Color x:Key="ColorGoldSoft">#7B6428</Color>
    <Color x:Key="ColorGreen">#00B889</Color>
    <Color x:Key="ColorGreenBright">#00E6A2</Color>
    <Color x:Key="ColorRed">#E63B59</Color>
    <Color x:Key="ColorRedBright">#FF5875</Color>
    <!-- Compatibility alias: existing BrushAccentBlue consumers now receive the gold brand accent. -->
    <Color x:Key="ColorAccentBlue">#D4AF37</Color>
    <Color x:Key="ColorAccentCyan">#49C8F5</Color>
    <Color x:Key="ColorAccentPurple">#B18CFF</Color>
    <Color x:Key="ColorTextPrimary">#F4F7FB</Color>
    <Color x:Key="ColorTextSecondary">#A6B5C5</Color>
    <Color x:Key="ColorTextMuted">#687B8F</Color>

    <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource ColorBackgroundDark}" />
    <SolidColorBrush x:Key="BrushSurfaceDark" Color="{StaticResource ColorSurfaceDark}" />
    <SolidColorBrush x:Key="BrushSurfaceLight" Color="{StaticResource ColorSurfaceLight}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderBright" Color="{StaticResource ColorBorderBright}" />
    <SolidColorBrush x:Key="BrushGold" Color="{StaticResource ColorGold}" />
    <SolidColorBrush x:Key="BrushGoldBright" Color="{StaticResource ColorGoldBright}" />
    <SolidColorBrush x:Key="BrushGoldSoft" Color="{StaticResource ColorGoldSoft}" />
    <SolidColorBrush x:Key="BrushGoldWash" Color="#18D4AF37" />
    <SolidColorBrush x:Key="BrushGoldBorder" Color="#66D4AF37" />
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="BrushGreenBright" Color="{StaticResource ColorGreenBright}" />
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}" />
    <SolidColorBrush x:Key="BrushRedBright" Color="{StaticResource ColorRedBright}" />
    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource ColorAccentPurple}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <LinearGradientBrush x:Key="BrushSurfaceGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#101B27" Offset="0" />
        <GradientStop Color="#0A111A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushButtonGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#192634" Offset="0" />
        <GradientStop Color="#101823" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushGoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE8A1" Offset="0" />
        <GradientStop Color="#D4AF37" Offset="0.52" />
        <GradientStop Color="#A98524" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BrushBackgroundDark}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Reusable glass panels/cards used across Dashboard, Calendar, Review, Replay, Settings and Analytics. -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceGlass}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.22" BlurRadius="18" ShadowDepth="2" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TerminalButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushButtonGlass}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGoldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{StaticResource BrushGoldWash}" />
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="#3A2F17" />
                            <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{StaticResource BrushGoldBright}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Default un-keyed buttons receive the same terminal finish; explicit named styles keep priority. -->
    <Style TargetType="Button" BasedOn="{StaticResource TerminalButton}" />

    <Style x:Key="TerminalPrimaryButton" TargetType="Button" BasedOn="{StaticResource TerminalButton}">
        <Setter Property="Background" Value="{StaticResource BrushGoldGradient}" />
        <Setter Property="Foreground" Value="#080A0D" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGoldBright}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- The top-level application navigation receives an elegant gold active indicator. -->
    <Style x:Key="NavigationTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="TabRoot" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ActiveIndicator" Height="2" VerticalAlignment="Bottom"
                                Margin="12,0,12,0" Background="{StaticResource BrushGoldGradient}"
                                CornerRadius="1" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabRoot" Property="Background" Value="#121B25" />
                            <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource BrushBorderBright}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource BrushGoldWash}" />
                            <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource BrushGoldBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" />
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TabRoot" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark text entry controls with a precise gold focus ring. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceLight}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushGoldBright}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushGold}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxRoot" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxRoot" Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemRoot" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource BrushGoldWash}" />
                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource BrushGoldBorder}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="#302716" />
                            <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceLight}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Type ComboBoxItem}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleRoot" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource BrushGoldBright}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{StaticResource BrushGold}" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleRoot" Property="Background" Value="#302716" /></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleRoot" Property="Opacity" Value="0.5" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource BrushSurfaceRaised}" BorderBrush="{StaticResource BrushGoldBorder}"
                                    BorderThickness="1" CornerRadius="9" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceLight}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushGoldBright}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrushGold}" />
    </Style>
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinWidth" Value="29" />
        <Setter Property="MinHeight" Value="27" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource BrushGoldWash}" /><Setter Property="BorderBrush" Value="{StaticResource BrushGold}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#5A491D" /><Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" /></Trigger>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BrushSurfaceLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    </Style>
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGoldBorder}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceLight}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="MinHeight" Value="29" />
    </Style>

    <!-- Tables: restrained separators, champagne headers and clear row selection. -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource BrushGoldWash}" /><Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="#182A38" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#13202B" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#292312" /><Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushBackgroundDark}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#1A2A38" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="{StaticResource BrushSurfaceDark}" />
        <Setter Property="AlternatingRowBackground" Value="#0D1721" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder" Grid.Column="0" Width="14" Height="14" CornerRadius="4"
                                Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorderBright}"
                                BorderThickness="1" VerticalAlignment="Center" />
                        <Path x:Name="CheckMark" Grid.Column="0" Data="M 2,7 L 5.5,10.5 L 12,3"
                              Stroke="#080A0D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource BrushGoldGradient}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource BrushGoldBright}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource BrushGold}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceDark}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="8,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource BrushGoldWash}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#292312" /><Setter Property="Foreground" Value="{StaticResource BrushGoldBright}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource BrushGold}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="8" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushGoldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
</ResourceDictionary>
