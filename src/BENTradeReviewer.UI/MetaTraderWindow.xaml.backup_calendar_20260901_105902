<Window x:Class="BENTradeReviewer.MetaTraderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEN TRADE REVIEWER — MetaTrader"
        Height="800"
        Width="1350"
        MinHeight="650"
        MinWidth="1100"
        Background="{StaticResource BrushBackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,10">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left">

                    <TextBlock Text="BEN TRADE REVIEWER"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="METATRADER JOURNAL"
                               Foreground="{StaticResource BrushAccentPurple}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">

                    <Button Content="IMPORT EA DATA"
                            Click="Import_Click"
                            Style="{StaticResource TerminalButton}"
                            Width="140"
                            Margin="0,0,6,0"/>

                    <Button Content="VIEW DETAIL"
                            Click="ViewDetail_Click"
                            Style="{StaticResource TerminalButton}"
                            Width="120"
                            Margin="0,0,6,0"/>

                    <Button Content="BACK"
                            Click="Back_Click"
                            Style="{StaticResource TerminalButton}"
                            Width="80"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===================================================== -->
        <!-- KPI -->
        <!-- ===================================================== -->

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,10">

            <!-- NET P&L -->

            <Border Style="{StaticResource CardPanel}"
                    Margin="3">

                <StackPanel>

                    <TextBlock Text="NET P&amp;L"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding NetPnL, StringFormat={}{0:C2}}"
                        Foreground="{StaticResource BrushTextPrimary}"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- WIN RATE -->

            <Border Style="{StaticResource CardPanel}"
                    Margin="3">

                <StackPanel>

                    <TextBlock Text="WIN RATE"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding WinRate, StringFormat={}{0:F1}%}"
                        Foreground="{StaticResource BrushTextPrimary}"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- TOTAL TRADES -->

            <Border Style="{StaticResource CardPanel}"
                    Margin="3">

                <StackPanel>

                    <TextBlock Text="TOTAL TRADES"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding TotalTrades}"
                        Foreground="{StaticResource BrushTextPrimary}"
                        FontSize="20"
                        FontWeight="Bold"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            <!-- MODE -->

            <Border Style="{StaticResource CardPanel}"
                    Margin="3">

                <StackPanel>

                    <TextBlock Text="MODE"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="10"
                               FontWeight="Bold"/>

                    <TextBlock Text="META"
                               Foreground="{StaticResource BrushAccentPurple}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- ===================================================== -->
        <!-- JOURNAL -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Style="{StaticResource CardPanel}"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,10">

                    <TextBlock
                        Text="META TRADER TRADE JOURNAL"
                        Foreground="{StaticResource BrushTextPrimary}"
                        FontSize="13"
                        FontWeight="Bold"/>

                    <TextBlock
                        DockPanel.Dock="Right"
                        Text="{Binding DataFolder}"
                        Foreground="{StaticResource BrushTextSecondary}"
                        FontSize="10"/>

                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Trades, Mode=OneWay}"
                          SelectedItem="{Binding SelectedTrade, Mode=TwoWay}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          CanUserResizeRows="False"
                          RowHeight="28"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          Foreground="{StaticResource BrushTextPrimary}"
                          IsReadOnly="True"
                          SelectionMode="Single">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="TIME"
                            Binding="{Binding EntryTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                            Width="160"/>

                        <DataGridTextColumn
                            Header="SYMBOL"
                            Binding="{Binding Symbol}"
                            Width="90"/>

                        <DataGridTextColumn
                            Header="SIDE"
                            Binding="{Binding Side}"
                            Width="70"/>

                        <DataGridTextColumn
                            Header="QTY"
                            Binding="{Binding Quantity, StringFormat={}{0:F2}}"
                            Width="75"/>

                        <DataGridTextColumn
                            Header="ENTRY"
                            Binding="{Binding EntryPrice, StringFormat={}{0:F5}}"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="SL"
                            Binding="{Binding StopLoss, TargetNullValue=N/A, StringFormat={}{0:F5}}"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="EXITS"
                            Binding="{Binding Exits.Count}"
                            Width="65"/>

                        <DataGridTextColumn
                            Header="EXIT TIME"
                            Binding="{Binding ExitTime, TargetNullValue=N/A, StringFormat={}{0:HH:mm:ss}}"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="GROSS P&amp;L"
                            Binding="{Binding PnL, StringFormat={}{0:C2}}"
                            Width="105"/>

                        <DataGridTextColumn
                            Header="OUTCOME"
                            Binding="{Binding Outcome}"
                            Width="110"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- STATUS -->
        <!-- ===================================================== -->

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource BrushTextSecondary}"
                   FontSize="11"
                   Margin="5,8,0,0"/>

    </Grid>
</Window>
