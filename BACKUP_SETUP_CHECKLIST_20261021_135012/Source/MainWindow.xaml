                                    <CheckBox Content="Trending" IsChecked="{Binding ActiveTrade.MarketContext.MarketTrending, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Ranging" IsChecked="{Binding ActiveTrade.MarketContext.MarketRanging, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Expansion" IsChecked="{Binding ActiveTrade.MarketContext.MarketExpansion, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Compression" IsChecked="{Binding ActiveTrade.MarketContext.MarketCompression, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Choppy" IsChecked="{Binding ActiveTrade.MarketContext.MarketChoppy, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                </WrapPanel>

                                <TextBlock Text="EVENT"
                                           Foreground="{StaticResource BrushAccentBlue}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.EventPhase, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          Background="{StaticResource BrushSurfaceLight}"
                                          Foreground="{StaticResource BrushTextPrimary}"
                                          TextElement.Foreground="{StaticResource BrushTextPrimary}"
                                          Margin="0,0,0,6">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Before"/>
                                    <ComboBoxItem Content="During"/>
                                    <ComboBoxItem Content="After"/>
                                </ComboBox>

