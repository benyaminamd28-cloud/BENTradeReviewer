                                    <CheckBox Content="+ Delta" IsChecked="{Binding ActiveTrade.MarketContext.FootprintPositiveDelta, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
