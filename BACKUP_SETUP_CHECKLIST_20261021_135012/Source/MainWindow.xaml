                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Present" IsChecked="{Binding ActiveTrade.MarketContext.IcebergPresent, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Native" IsChecked="{Binding ActiveTrade.MarketContext.IcebergNative, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Synthetic" IsChecked="{Binding ActiveTrade.MarketContext.IcebergSynthetic, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
