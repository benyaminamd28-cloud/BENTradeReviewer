                                         Foreground="{StaticResource BrushTextPrimary}"
                                         BorderBrush="{StaticResource BrushBorder}"
                                         Padding="5"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="THESIS"
                                           Foreground="{StaticResource BrushAccentBlue}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.TradeThesis, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          Background="{StaticResource BrushSurfaceLight}"
                                          Foreground="{StaticResource BrushTextPrimary}"
                                          TextElement.Foreground="{StaticResource BrushTextPrimary}"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Content="Reversal"/>
                                    <ComboBoxItem Content="Continuation"/>
                                    <ComboBoxItem Content="Breakout"/>
                                    <ComboBoxItem Content="Failed Breakout"/>
                                    <ComboBoxItem Content="CHoCH / Structure Change"/>
                                    <ComboBoxItem Content="Liquidity Sweep"/>
                                    <ComboBoxItem Content="Momentum"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>

                                <TextBlock Text="EXECUTION QUALITY"
                                           Foreground="{StaticResource BrushAccentBlue}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
