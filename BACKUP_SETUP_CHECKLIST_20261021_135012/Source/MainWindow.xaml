                                           Foreground="{StaticResource BrushAccentBlue}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding ActiveTrade.MarketContext.ContextConfidence, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Background="{StaticResource BrushSurfaceLight}"
                                          Foreground="{StaticResource BrushTextPrimary}"
                                          TextElement.Foreground="{StaticResource BrushTextPrimary}"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Tag="0" Content="Low"/>
                                    <ComboBoxItem Tag="1" Content="Medium"/>
                                    <ComboBoxItem Tag="2" Content="High"/>
                                </ComboBox>

                                <TextBlock Text="TRADE QUALITY"
                                           Foreground="{StaticResource BrushAccentBlue}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
