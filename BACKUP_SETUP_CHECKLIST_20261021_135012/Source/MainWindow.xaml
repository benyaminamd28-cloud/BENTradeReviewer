                                              IsChecked="{Binding ActiveTrade.MarketContext.GexNearLevel, Mode=TwoWay}"
                                              Foreground="{StaticResource BrushTextPrimary}"
                                              Margin="0,0,10,5"/>
                                </WrapPanel>

                                <TextBlock Text="GEX RELATION"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
