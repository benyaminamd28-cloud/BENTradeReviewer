                                    <CheckBox Content="Liquidity Pull" IsChecked="{Binding ActiveTrade.MarketContext.DomLiquidityPull, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Pressure Divergence" IsChecked="{Binding ActiveTrade.MarketContext.DomPressureDivergence, Mode=TwoWay}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,5"/>
                                </WrapPanel>

                                <TextBlock Text="FOOTPRINT"
                                           Foreground="{StaticResource BrushAccentBlue}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
