                DockPanel.Dock="Right"/>
        </DockPanel>

        <DockPanel Margin="0,3">
            <TextBlock
                Text="MFE USD"
                Foreground="{StaticResource BrushTextSecondary}"/>
            <TextBlock
                Text="{Binding ActiveTrade.MFEUSD, StringFormat={}{0:C2}, TargetNullValue=N/A}"
                Foreground="{StaticResource BrushGreenBright}"
