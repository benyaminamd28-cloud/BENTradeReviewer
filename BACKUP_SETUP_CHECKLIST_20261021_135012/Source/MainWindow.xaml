                FontWeight="Bold">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter
                            Property="Foreground"
                            Value="{StaticResource BrushGreenBright}"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ActiveTrade.NetPnL, Converter={StaticResource IsNegativeConverter}}"
                                Value="True">
                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource BrushRedBright}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </StackPanel>
</Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="JOURNAL &amp; TAGS" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
