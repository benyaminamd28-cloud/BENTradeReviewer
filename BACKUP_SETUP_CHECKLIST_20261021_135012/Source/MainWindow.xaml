<Window x:Class="BENTradeReviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BENTradeReviewer.UI.Controls"
        Title="{Binding WindowTitle}" Height="950" Width="1600" MinHeight="700" MinWidth="1100"
        Background="{StaticResource BrushBackgroundDark}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/BENTradeReviewer.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceDark}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="15,9">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="BEN" Foreground="{StaticResource BrushAccentBlue}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" TRADE REVIEWER" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton Content="DASHBOARD &amp; CALENDAR" GroupName="Navigation" IsChecked="{Binding SelectedNavigationIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" Style="{StaticResource NavigationTabStyle}"/>
                    <RadioButton Content="DAY REVIEW &amp; REPLAY" GroupName="Navigation" IsChecked="{Binding SelectedNavigationIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}" Style="{StaticResource NavigationTabStyle}" Margin="8,0,0,0"/>
                    <RadioButton Content="SETTINGS" GroupName="Navigation" IsChecked="{Binding SelectedNavigationIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}" Style="{StaticResource NavigationTabStyle}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBox Width="190" Height="28" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0"/>
                    <Button Content="IMPORT RECORDER" Command="{Binding ImportCommand}" Style="{StaticResource TerminalButton}" Margin="0,0,6,0"/>
                    <Button Content="REFRESH" Command="{Binding RefreshAllCommand}" Style="{StaticResource TerminalButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BrushBackgroundDark}" Padding="15,10">
            <UniformGrid Columns="8">
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="NET P&amp;L" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.NetPnL, StringFormat={}{0:C2}}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource BrushGreenBright}"/><Style.Triggers><DataTrigger Binding="{Binding Summary.NetPnL, Converter={StaticResource IsNegativeConverter}}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushRedBright}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="WIN RATE" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.WinRate, StringFormat={}{0:F1}%}" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="PROFIT FACTOR" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.ProfitFactor, StringFormat={}{0:F2}}" Foreground="{StaticResource BrushAccentBlue}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="TOTAL TRADES" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.TotalTrades}" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="AVG WIN" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.AverageWin, StringFormat={}{0:C2}}" Foreground="{StaticResource BrushGreenBright}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="AVG LOSS" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.AverageLoss, StringFormat={}{0:C2}}" Foreground="{StaticResource BrushRedBright}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="AVG R:R" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.AverageRR, StringFormat={}1 : {0:F2}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardPanel}" Margin="3"><StackPanel><TextBlock Text="MAX DRAWDOWN" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Summary.MaxDrawdown, StringFormat={}{0:C2}}" Foreground="{StaticResource BrushRedBright}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2" Margin="15,0,15,10" ClipToBounds="True">
            <Grid Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="◀" Command="{Binding NavigateMonthCommand}" CommandParameter="-1" Style="{StaticResource TerminalButton}" Width="32" Height="28"/>
                        <TextBlock Text="{Binding SelectedMonth, StringFormat={}{0:MMMM yyyy}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0"/>
                        <Button Content="▶" Command="{Binding NavigateMonthCommand}" CommandParameter="1" Style="{StaticResource TerminalButton}" Width="32" Height="28"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="Instrument:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="85" SelectedValuePath="Content" SelectedValue="{Binding SelectedInstrumentFilter}" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" TextElement.FontWeight="SemiBold"><ComboBoxItem Content="ALL"/><ComboBoxItem Content="6E"/><ComboBoxItem Content="ES"/><ComboBoxItem Content="NQ"/><ComboBoxItem Content="MES"/><ComboBoxItem Content="MNQ"/><ComboBoxItem Content="CL"/><ComboBoxItem Content="GC"/><ComboBoxItem Content="RTY"/><ComboBoxItem Content="ZB"/></ComboBox>
                        <TextBlock Text="Side:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="12,0,5,0"/>
                        <ComboBox Width="80" SelectedValuePath="Content" SelectedValue="{Binding SelectedSideFilter}" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" TextElement.FontWeight="SemiBold"><ComboBoxItem Content="ALL"/><ComboBoxItem Content="Long"/><ComboBoxItem Content="Short"/></ComboBox>
                        <TextBlock Text="Outcome:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="12,0,5,0"/>
                        <ComboBox Width="90" SelectedValuePath="Content" SelectedValue="{Binding SelectedOutcomeFilter}" Background="{StaticResource BrushSurfaceLight}" Foreground="{StaticResource BrushTextPrimary}" TextElement.Foreground="{StaticResource BrushTextPrimary}" TextElement.FontWeight="SemiBold"><ComboBoxItem Content="ALL"/><ComboBoxItem Content="WIN"/><ComboBoxItem Content="LOSS"/></ComboBox>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- MON-FRI trading calendar + dedicated weekly P&L column -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="MON" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="TUE" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="WED" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="THU" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="FRI" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="WEEKLY P&amp;L" Foreground="{StaticResource BrushTextPrimary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeeklyCalendarRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="88">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="145"/>
                                        </Grid.ColumnDefinitions>

                                        <ItemsControl Grid.Column="0" Grid.ColumnSpan="5" ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="5"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0.5" Margin="2" CornerRadius="4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
    <Setter Property="Background" Value="#12161C"/>

    <Style.Triggers>

        <!-- Adjacent month: visually subdued, but still contains real trade data -->
        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
            <Setter Property="Opacity" Value="0.28"/>
        </DataTrigger>

        <!-- PROFIT -->
        <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding HasTrades}" Value="True"/>
                <Condition Binding="{Binding IsProfitable}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="#1A2D23"/>
        </MultiDataTrigger>

        <!-- LOSS -->
        <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding HasTrades}" Value="True"/>
                <Condition Binding="{Binding IsLosing}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="#2D1A1D"/>
        </MultiDataTrigger>

        <!-- BREAK EVEN -->
        <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding HasTrades}" Value="True"/>
                <Condition Binding="{Binding IsProfitable}" Value="False"/>
                <Condition Binding="{Binding IsLosing}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Background" Value="#3A2814"/>
        </MultiDataTrigger>

    </Style.Triggers>
</Style>
                                                        </Border.Style>

                                                        <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Date}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch">
                                                            <Grid Margin="7">
                                                                <TextBlock Text="{Binding DayNumber}"
                                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Top"/>

                                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">

                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasTrades}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>

                                                                        <TextBlock Text="DAILY P&amp;L"
                                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"/>

                                                                        <TextBlock Text="{Binding DailyPnL, StringFormat={}{0:C2}}"
                                                                                   FontSize="14"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushGreenBright}"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding HasTrades}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsLosing}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Foreground" Value="{StaticResource BrushRedBright}"/>
                                                                                        </MultiDataTrigger>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding HasTrades}" Value="True"/>
                                                                                                <Condition Binding="{Binding IsProfitable}" Value="False"/>
                                                                                                <Condition Binding="{Binding IsLosing}" Value="False"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Foreground" Value="#FFB347"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <TextBlock Text="{Binding TradeCount, StringFormat={}{0} trades}"
                                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                                   FontSize="10"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <TextBlock Text="NO TRADE"
                                                                               Foreground="{StaticResource BrushTextSecondary}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasTrades}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Weekly total aligned with this exact week row -->
                                        <Border Grid.Column="5"
        Margin="2"
        CornerRadius="4"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1">

    <Border.Style>
        <Style TargetType="Border">

            <Setter Property="Background" Value="#161B22"/>

            <Style.Triggers>

                <!-- WEEKLY PROFIT -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasTrades}" Value="True"/>
                        <Condition Binding="{Binding IsProfitable}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1A2D23"/>
                </MultiDataTrigger>

                <!-- WEEKLY LOSS -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasTrades}" Value="True"/>
                        <Condition Binding="{Binding IsLosing}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2D1A1D"/>
                </MultiDataTrigger>

                <!-- WEEKLY BREAK EVEN -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasTrades}" Value="True"/>
                        <Condition Binding="{Binding IsProfitable}" Value="False"/>
                        <Condition Binding="{Binding IsLosing}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#3A2814"/>
                </MultiDataTrigger>

            </Style.Triggers>
        </Style>
    </Border.Style>

    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center">

        <TextBlock Text="{Binding WeeklyPnL, StringFormat={}{0:C2}}"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center">

            <TextBlock.Style>
                <Style TargetType="TextBlock">

                    <!-- DEFAULT = PROFIT -->
                    <Setter Property="Foreground"
                            Value="{StaticResource BrushGreenBright}"/>

                    <Style.Triggers>

                        <!-- LOSS = RED -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasTrades}" Value="True"/>
                                <Condition Binding="{Binding IsLosing}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground"
                                    Value="{StaticResource BrushRedBright}"/>
                        </MultiDataTrigger>

                        <!-- BREAK EVEN = ORANGE -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasTrades}" Value="True"/>
                                <Condition Binding="{Binding IsProfitable}" Value="False"/>
                                <Condition Binding="{Binding IsLosing}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground"
                                    Value="#FFB347"/>
                        </MultiDataTrigger>

                    </Style.Triggers>
                </Style>
            </TextBlock.Style>

        </TextBlock>

    </StackPanel>

</Border>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding DataContext.SelectedNavigationIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}" DataContext="{Binding DayReviewVM}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding CurrentDate, StringFormat={}{0:D}}" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>                    <Border x:Name="VideoViewport"
                            Grid.Row="1"
                            Background="#000"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True"
                            PreviewMouseWheel="VideoViewport_PreviewMouseWheel"
                            PreviewMouseLeftButtonDown="VideoViewport_MouseLeftButtonDown"
                            PreviewMouseMove="VideoViewport_MouseMove"
                            PreviewMouseLeftButtonUp="VideoViewport_MouseLeftButtonUp"
                            >

                        <Grid x:Name="VideoCanvas"
                              Background="#000"
                              ClipToBounds="True">

                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="VideoScale"
                                                    ScaleX="1"
                                                    ScaleY="1"/>
                                    <TranslateTransform x:Name="VideoTranslate"
                                                         X="0"
                                                         Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <MediaElement x:Name="VideoPlayer0"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <controls:TradeTimelineControl x:Name="TimelineControl" Height="24" CurrentPositionSeconds="{Binding CurrentVideoTime, Mode=OneWay}" TotalDurationSeconds="{Binding TotalVideoDuration}" ActiveTrade="{Binding ActiveTrade}"/>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="⏮ -5s" Command="{Binding SeekRelativeCommand}" CommandParameter="-5" Style="{StaticResource TerminalButton}" Click="TimelineControlButton_Click" Margin="0,0,5,0"/>
                                <Button Content="PLAY / PAUSE" Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource TerminalButton}" Click="TimelineControlButton_Click" Margin="0,0,5,0"/>
                                <Button Content="+5s ⏭" Command="{Binding SeekRelativeCommand}" CommandParameter="5" Style="{StaticResource TerminalButton}" Click="TimelineControlButton_Click" Margin="0,0,12,0"/>
                                <Button Content="FIT"

        Style="{StaticResource TerminalButton}"
        Margin="0,0,12,0" Click="FitVideo_Click"/>
                                <TextBlock Text="Speed:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Button Content="0.5x" Command="{Binding ChangeSpeedCommand}" CommandParameter="0.5" Style="{StaticResource TerminalButton}" Click="TimelineControlButton_Click" Margin="0,0,4,0"/>
                                <Button Content="1.0x" Command="{Binding ChangeSpeedCommand}" CommandParameter="1" Style="{StaticResource TerminalButton}" Click="TimelineControlButton_Click" Margin="0,0,4,0"/>
                                <Button Content="2.0x" Command="{Binding ChangeSpeedCommand}" CommandParameter="2" Style="{StaticResource TerminalButton}" Click="TimelineControlButton_Click"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"><TextBlock.Text><MultiBinding StringFormat="{}{0:mm\:ss} / {1:mm\:ss}"><Binding Path="CurrentVideoTime" Converter="{StaticResource SecondsToTimeSpanConverter}"/><Binding Path="TotalVideoDuration" Converter="{StaticResource SecondsToTimeSpanConverter}"/></MultiBinding></TextBlock.Text></TextBlock>
                        </DockPanel>
                    </StackPanel>
                    <Border Grid.Row="3" Style="{StaticResource CardPanel}">
                        <DataGrid x:Name="TradesGrid" ItemsSource="{Binding DayTrades}" SelectedItem="{Binding ActiveTrade, Mode=OneWay}" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#1A202C" Foreground="{StaticResource BrushTextPrimary}" SelectionChanged="TradesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding EntryTime, StringFormat={}{0:HH:mm:ss}}" Width="85"/><DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70"/><DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="65"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="45"/><DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice}" Width="85"/><DataGridTextColumn Header="Exit" Binding="{Binding ExitPrice}" Width="85"/><DataGridTextColumn Header="P&amp;L" Binding="{Binding NetPnL, StringFormat={}{0:C2}}" Width="95"/><DataGridTextColumn Header="R:R" Binding="{Binding RealizedRR, StringFormat={}1:{0}}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10"><StackPanel><TextBlock Text="TRADE SUMMARY" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/><DockPanel Margin="0,3"><TextBlock Text="Instrument" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="{Binding ActiveTrade.Symbol}" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel><DockPanel Margin="0,3"><TextBlock Text="Side" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="{Binding ActiveTrade.Side}" Foreground="{StaticResource BrushAccentBlue}" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel><DockPanel Margin="0,3"><TextBlock Text="Quantity" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="{Binding ActiveTrade.Quantity}" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Right"/></DockPanel><DockPanel Margin="0,3"><TextBlock Text="Entry" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="{Binding ActiveTrade.EntryPrice}" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Right"/></DockPanel><DockPanel Margin="0,3"><TextBlock Text="Exit" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="{Binding ActiveTrade.ExitPrice}" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Right"/></DockPanel><DockPanel Margin="0,3"><TextBlock Text="Duration" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="{Binding ActiveTrade.Duration}" Foreground="{StaticResource BrushTextPrimary}" DockPanel.Dock="Right"/></DockPanel></StackPanel></Border>
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,10">
    <StackPanel>
        <TextBlock
            Text="RISK &amp; REWARD"
            Foreground="{StaticResource BrushTextSecondary}"
            FontSize="12"
            FontWeight="Bold"
            Margin="0,0,0,10"/>

        <DockPanel Margin="0,3">
            <TextBlock
                Text="Initial Stop"
                Foreground="{StaticResource BrushTextSecondary}"/>
            <TextBlock
                Text="{Binding ActiveTrade.InitialStopLoss, TargetNullValue=N/A, StringFormat={}{0:F4}}"
                Foreground="{StaticResource BrushRedBright}"
                DockPanel.Dock="Right"/>
        </DockPanel>

        <DockPanel Margin="0,3">
            <TextBlock
                Text="Initial Target"
                Foreground="{StaticResource BrushTextSecondary}"/>
            <TextBlock
                Text="{Binding ActiveTrade.InitialTakeProfit, TargetNullValue=N/A, StringFormat={}{0:F4}}"
